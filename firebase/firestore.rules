rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────── LECTURE PUBLIQUE ───────────────────────────
    // Les annonces et les avis sont lisibles SANS COMPTE (navigation libre,
    // exigence produit : les visiteurs voient les publications directement).
    match /listings/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.imageUrls is list
        && request.resource.data.imageUrls.size() <= 6
        && request.resource.data.price is number
        && request.resource.data.price >= 0;
      allow update: if request.auth != null
        && resource.data.sellerId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.sellerId == request.auth.uid;
    }
    match /reviews/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorId != request.resource.data.targetId;
      allow update, delete: if false;
    }

    // ─────────────────────────── UTILISATEURS ───────────────────────────
    match /users/{uid} {
      allow read: if true; // nom/vendeur visible de tous (nécessaire)
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // ─────────────────────────── TRANSACTIONS SÉCURISÉES ───────────────────
    // Flux anti-arnaque : ni l'acheteur ni le vendeur ne peuvent modifier
    // l'historique ou la commission. Seul le créateur (acheteur) crée,
    // les 2 parties + admin peuvent faire évoluer le statut de validation.
    match /transactions/{id} {
      // Lisible par les 2 participants et l'admin seulement.
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.participants
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      // Création = l'acheteur initie (le prix doit être > 0).
      allow create: if request.auth != null
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.buyerId != request.resource.data.sellerId
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.commission ==
           request.resource.data.price * 0.06; // commission admin verrouillée
      allow update: if request.auth != null && (
        // Les 2 parties peuvent confirmer leur réception/paiement.
        request.auth.uid in resource.data.participants
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow delete: if false; // jamais supprimable (traçabilité)
    }

    // ─────────────────────────── CONVERSATIONS & MESSAGES ───────────────────
    match /conversations/{id} {
      allow read, update: if request.auth != null
        && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds;
      allow delete: if false;
    }
    match /messages/{id} {
      allow read, create: if request.auth != null
        && exists(/databases/$(database)/documents/conversations/
           $(request.resource.data.conversationId));
      allow update, delete: if false;
    }

    // ─────────────────────────── FAVORIS ───────────────────────────
    match /favorites/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ─────────────────────────── SIGNALEMENTS (admin) ───────────────────
    match /reports/{id} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
  }
}

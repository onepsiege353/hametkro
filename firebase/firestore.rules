rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- UTILISATEURS ----
    match /users/{uid} {
      // Lire le profil de n'importe qui (nécessaire pour les vendeurs/acheteurs)
      allow read: if true;
      // Ne modifier que son propre profil
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // ---- ANNONCES (listings) ----
    match /listings/{id} {
      allow read: if true; // visible en lecture (le fil est filtré par l'app selon le pays)
      allow create: if request.auth != null
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.imageUrls is list
        && request.resource.data.imageUrls.size() <= 6
        && request.resource.data.price is number
        && request.resource.data.price >= 0;
      // Le vendeur peut modifier sa propre annonce (ex: marquer vendu)
      allow update: if request.auth != null
        && resource.data.sellerId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.sellerId == request.auth.uid;
    }

    // ---- CONVERSATIONS (2 participants seulement) ----
    match /conversations/{id} {
      allow read, update: if request.auth != null
        && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds;
      allow delete: if false;
    }

    // ---- MESSAGES (dans une conversation dont on est membre) ----
    match /messages/{id} {
      allow read, create, update: if request.auth != null
        && exists(/databases/$(database)/documents/conversations/
           $(request.resource.data.conversationId))
        && request.resource.data.senderId == request.auth.uid;
      allow delete: if false;
    }

    // ---- FAVORIS (son propre doc seulement) ----
    match /favorites/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- AVIS (reviews) ----
    match /reviews/{id} {
      allow read: if true;
      // On ne peut pas se noter soi-même
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorId != request.resource.data.targetId;
      allow update, delete: if false;
    }

    // ---- SIGNALEMENTS (reports) ----
    match /reports/{id} {
      // Seul le modérateur lit/supprime ; on écrit sur des lignes créées.
      allow create: if request.auth != null;
      allow read: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
